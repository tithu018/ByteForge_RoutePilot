# Copy to .env at the repository root. These credentials are local development ONLY.
NODE_ENV=development
API_PORT=3000
WEB_PORT=5173
POSTGRES_PORT=55432
POSTGRES_DB=waypoint
POSTGRES_USER=waypoint
POSTGRES_PASSWORD=waypoint_local_only
# Used by host-run Prisma/API. Compose supplies its own postgres-host URL from the above values.
DATABASE_URL=postgresql://waypoint:waypoint_local_only@localhost:55432/waypoint?schema=public
# Browser uses a same-origin relative API path; the dev server proxies it to API_BASE_URL.
VITE_API_BASE_URL=/api/v1
API_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:5173
# Reserved for the authentication phase. Not consumed and not a working auth secret.
JWT_SECRET=REPLACE_IN_AUTHENTICATION_PHASE
